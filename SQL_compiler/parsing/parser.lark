%import common.NUMBER
%import common.ESCAPED_STRING
%import common.LETTER
%import common.DIGIT
%import common.WS
%import common.NEWLINE
%import common.SH_COMMENT

%ignore WS
%ignore SH_COMMENT

COMMENT: "/*" /(.|\n|\r)+/ "*/"
%ignore COMMENT

SELECT: "select"i
FROM: "from"i
WHERE: "where"i
AND: "and"i
OR: "or"i
NOT: "not"i
LIKE: "like"i
IN: "in"i
IS: "is"i
NULL: "null"i
TRUE: "true"i
FALSE: "false"i
DISTINCT: "distinct"i
AS: "as"i
ON: "on"i
JOIN: "join"i
INNER: "inner"i
LEFT: "left"i
RIGHT: "right"i
OUTER: "outer"i
CROSS: "cross"i
GROUP: "group"i
BY: "by"i
HAVING: "having"i
ORDER: "order"i
ASC: "asc"i
DESC: "desc"i
LIMIT: "limit"i
OFFSET: "offset"i
BETWEEN: "between"i
EXISTS: "exists"i
UNION: "union"i
ALL: "all"i
ANY: "any"i
CONCAT: "||"

IDENT: LETTER (LETTER | DIGIT | "_")*
STAR: "*"
COMMA: ","
DOT: "."
LPAREN: "("
RPAREN: ")"
SEMICOLON: ";"
PLUS: "+"
MINUS: "-"
STRING: /'[^']*'/ | /"[^"]*"/

num: NUMBER
string: STRING
bool: TRUE | FALSE
null: NULL -> null_const
distinct: DISTINCT

ident: IDENT -> simple_ident \
     | ident DOT IDENT -> compound_ident

function_call: IDENT LPAREN function_args? RPAREN -> function_call

?function_args: star_args
              | distinct_args
              | expr_args

star_args: STAR
distinct_args: DISTINCT expr_list
expr_args: expr_list

// Базовые атомарные выражения
?atom: num
     | string
     | bool
     | null
     | ident
     | function_call
     | LPAREN expr RPAREN
     | EXISTS LPAREN select_stmt RPAREN -> exists_subquery
     | LPAREN select_stmt RPAREN -> scalar_subquery

// Унарные выражения
?unary_expr: atom
           | PLUS unary_expr -> plus
           | MINUS unary_expr -> minus
           | NOT unary_expr -> not_expr

// Математические операции
?mul_expr: unary_expr
         | mul_expr STAR unary_expr -> mul
         | mul_expr "/" unary_expr -> div
         | mul_expr "%" unary_expr -> rem

?add_expr: mul_expr
         | add_expr "+" mul_expr -> add
         | add_expr "-" mul_expr -> sub

// Сравнения
?compare_expr: add_expr
             | add_expr ">" add_expr -> gt
             | add_expr ">=" add_expr -> ge
             | add_expr "<" add_expr -> lt
             | add_expr "<=" add_expr -> le
             | add_expr "=" add_expr -> eq
             | add_expr "!=" add_expr -> ne
             | add_expr "<>" add_expr -> ne
             | add_expr ">" ALL LPAREN select_stmt RPAREN -> all_any_gt
             | add_expr ">=" ALL LPAREN select_stmt RPAREN -> all_any_ge
             | add_expr "<" ALL LPAREN select_stmt RPAREN -> all_any_lt
             | add_expr "<=" ALL LPAREN select_stmt RPAREN -> all_any_le
             | add_expr "=" ALL LPAREN select_stmt RPAREN -> all_any_eq
             | add_expr "!=" ALL LPAREN select_stmt RPAREN -> all_any_ne
             | add_expr "<>" ALL LPAREN select_stmt RPAREN -> all_any_ne2
             | add_expr ">" ANY LPAREN select_stmt RPAREN -> any_gt
             | add_expr ">=" ANY LPAREN select_stmt RPAREN -> any_ge
             | add_expr "<" ANY LPAREN select_stmt RPAREN -> any_lt
             | add_expr "<=" ANY LPAREN select_stmt RPAREN -> any_le
             | add_expr "=" ANY LPAREN select_stmt RPAREN -> any_eq
             | add_expr "!=" ANY LPAREN select_stmt RPAREN -> any_ne
             | add_expr "<>" ANY LPAREN select_stmt RPAREN -> any_ne2

// LIKE оператор
?like_expr: compare_expr
          | compare_expr LIKE compare_expr -> like

// IS NULL оператор
?is_expr: like_expr
        | like_expr IS NULL -> is_null
        | like_expr IS NOT NULL -> is_not_null

// IN оператор - исправлен для избежания конфликтов
?in_expr: is_expr
        | is_expr NOT? IN LPAREN in_elements RPAREN -> in_expression

// Разделяем элементы для IN
in_elements: expr_list -> in_value_list
           | select_stmt -> in_subquery_stmt

// BETWEEN оператор
?between_expr: in_expr
             | in_expr NOT? BETWEEN in_expr AND in_expr -> between_expression

// Конкатенация строк
?concat_expr: between_expr
            | concat_expr CONCAT concat_expr -> concat_expr

// AND/OR операции
?and_expr: concat_expr (AND concat_expr)*
?or_expr: and_expr (OR and_expr)*

expr: or_expr
expr_list: expr (COMMA expr)*

// SELECT запрос
select_stmt: SELECT distinct? select_list \
             (FROM table_refs)? \
             (WHERE expr)? \
             (GROUP BY expr_list (HAVING expr)?)? \
             (ORDER BY ordering_term (COMMA ordering_term)*)? \
             (LIMIT expr (OFFSET expr)?)? \
             (UNION (ALL)? select_stmt)? \
             SEMICOLON? -> select_stmt

where_clause: WHERE expr -> where_clause
where_expr: expr -> where_expr

select_list: select_item (COMMA select_item)* -> select_list

select_item: expr (AS? ident)? -> select_item \
           | STAR -> select_all \
           | qualified_star -> select_qualified_all

qualified_star: ident DOT STAR

table_refs: table_ref (COMMA table_ref)* -> table_refs

table_ref: table_primary (join_clause)* -> table_ref

table_primary: ident (AS? ident)? -> table_base \
             | LPAREN select_stmt RPAREN (AS? ident)? -> table_subquery

join_clause: join_type? JOIN table_primary (ON expr)? -> join_clause

join_type: INNER -> inner_join \
         | LEFT (OUTER)? -> left_join \
         | RIGHT (OUTER)? -> right_join \
         | CROSS -> cross_join

ordering_term: expr (ASC | DESC)? -> ordering_term

start: select_stmt